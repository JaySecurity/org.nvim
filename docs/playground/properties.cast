[0,"o","\u001b[1;1H\u001b[0m#+TITLE:\u001b[0;1m org.nvim tutor 8: properties and column view\u001b[0m \u001b[0;38;2;155;158;164m ✓ 0/10\u001b[0m\u001b[K\u001b[2;1H\u001b[0m#+STARTUP:\u001b[0;38;2;179;246;192m showall nologdone\u001b[0m\u001b[K\u001b[3;1H\u001b[0m#+TODO:\u001b[0;38;2;179;246;192m TODO | DONE\u001b[0m\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[0mProperties are named values on a headline, such as a colour, an owner\u001b[K\u001b[6;1H\u001b[0mor how long a task will take. Column view shows them as a table over\u001b[K\u001b[7;1H\u001b[0myour outline, where you can edit them and see their sums.\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H\u001b[0;38;2;140;248;247m-\u001b[0m As before, a ✓ at the end of an exercise's headline means it is\u001b[K\u001b[10;1H\u001b[0m  done, and ✗ that it is not yet. Keys are shown as mapped in your\u001b[K\u001b[11;1H\u001b[0m  config; \u001b[0;38;2;179;246;192m=<leader>=\u001b[0m is \u001b[0;38;2;179;246;192m=<Space>=\u001b[0m.\u001b[K\u001b[12;1H\u001b[0;38;2;140;248;247m-\u001b[0m This is a working copy: \u001b[0;38;2;179;246;192m=:w=\u001b[0m saves your progress and \u001b[0;38;2;179;246;192m=:Org tutor\u001b[0m\u001b[K\u001b[13;1H\u001b[0;38;2;179;246;192m  properties reset=\u001b[0m starts over. Nothing here touches your notes.\u001b[K\u001b[14;1H\u001b[0;38;2;140;248;247m-\u001b[0m Stuck? \u001b[0;38;2;179;246;192m=:Org tutor_hint=\u001b[0m shows the keys that solve the exercise at\u001b[K\u001b[15;1H\u001b[0m  the cursor, and \u001b[0;38;2;179;246;192m=:Org tutor=\u001b[0m lists every lesson.\u001b[K\u001b[16;1H\u001b[K\u001b[17;1H\u001b[0;1m* Lesson 1: properties\u001b[0m\u001b[K\u001b[18;1H\u001b[0mProperties live in a \u001b[0;38;2;179;246;192m=:PROPERTIES:=\u001b[0m drawer right under the headline, one\u001b[K\u001b[19;1H\u001b[0;38;2;179;246;192m=:Name: value=\u001b[0m per line. You rarely type the drawer yourself: the keys\u001b[K\u001b[20;1H\u001b[0mbelow make it for you. Drawers start folded; \u001b[0;38;2;179;246;192m=<Tab>=\u001b[0m on the\u001b[K\u001b[21;1H\u001b[0;38;2;179;246;192m=:PROPERTIES:=\u001b[0m line opens and closes one.\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m properties.org                                                             1:1 \u001b[0m\u001b[K\u001b[23;1H\u001b[0m                                                                                \u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[2 q\u001b[1;1H"]
