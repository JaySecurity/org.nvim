[0,"o","\u001b[1;1H\u001b[0m#+TITLE:\u001b[0;1m org.nvim tutor 7: organize and find\u001b[0m \u001b[0;38;2;155;158;164m ✓ 0/11\u001b[0m\u001b[K\u001b[2;1H\u001b[0m#+STARTUP:\u001b[0;38;2;179;246;192m showall nologdone\u001b[0m\u001b[K\u001b[3;1H\u001b[0m#+TODO:\u001b[0;38;2;179;246;192m TODO | DONE\u001b[0m\u001b[K\u001b[4;1H\u001b[0m#+ARCHIVE:\u001b[0;38;2;179;246;192m %s_archive::\u001b[0m\u001b[K\u001b[5;1H\u001b[K\u001b[6;1H\u001b[0mNotes pile up. This lesson shows how to keep a file in order: move\u001b[K\u001b[7;1H\u001b[0mentries where they belong (refile), put finished work out of the way\u001b[K\u001b[8;1H\u001b[0m(archive), and find things again: sparse trees, jumping to a heading,\u001b[K\u001b[9;1H\u001b[0mnarrowing to one subtree and searching tags in the agenda.\u001b[K\u001b[10;1H\u001b[K\u001b[11;1H\u001b[0;38;2;140;248;247m-\u001b[0m As before, a ✓ at the end of an exercise's headline means it is\u001b[K\u001b[12;1H\u001b[0m  done, and ✗ that it is not yet. Keys are shown as mapped in your\u001b[K\u001b[13;1H\u001b[0m  config; \u001b[0;38;2;179;246;192m=<leader>=\u001b[0m is \u001b[0;38;2;179;246;192m=<Space>=\u001b[0m.\u001b[K\u001b[14;1H\u001b[0;38;2;140;248;247m-\u001b[0m This is a working copy: \u001b[0;38;2;179;246;192m=:w=\u001b[0m saves your progress and \u001b[0;38;2;179;246;192m=:Org tutor\u001b[0m\u001b[K\u001b[15;1H\u001b[0;38;2;179;246;192m  organize reset=\u001b[0m starts over. The \u001b[0;38;2;179;246;192m=#+ARCHIVE:=\u001b[0m line at the top sends\u001b[K\u001b[16;1H\u001b[0m  archived entries to a file next to this copy, away from your notes.\u001b[K\u001b[17;1H\u001b[0;38;2;140;248;247m-\u001b[0m Stuck? \u001b[0;38;2;179;246;192m=:Org tutor_hint=\u001b[0m shows the keys that solve the exercise at\u001b[K\u001b[18;1H\u001b[0m  the cursor, and \u001b[0;38;2;179;246;192m=:Org tutor=\u001b[0m lists every lesson.\u001b[K\u001b[19;1H\u001b[K\u001b[20;1H\u001b[0;1m* Lesson 1: refile\u001b[0m\u001b[K\u001b[21;1H\u001b[0mRefiling moves a subtree, with everything in it, under another\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m organize.org                                                               1:1 \u001b[0m\u001b[K\u001b[23;1H\u001b[0m                                                                                \u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[2 q\u001b[1;1H"]
[1.5,"m","say: Refile, archive and search, all tried out in this one file."]
[7.555,"m","1.1 Refile a task"]
[7.555,"o","\u001b[1;1H\u001b[0m** 1.1 Refile a task \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPut the cursor on \u001b[0;38;2;179;246;192m=Buy stamps=\u001b[0m and press \u001b[0;38;2;179;246;192m=<leader>or=\u001b[0m. Pick \u001b[0;38;2;179;246;192m=Errands=\u001b[0m\u001b[K\u001b[3;1H\u001b[0min the list: the task moves to the end of \u001b[0;38;2;179;246;192m=Errands=\u001b[0m, the headline after\u001b[K\u001b[4;1H\u001b[0mthis lesson.\u001b[K\u001b[6;1H\u001b[0;38;2;166;219;255m*** \u001b[0;38;2;255;192;185mTODO\u001b[0;38;2;166;219;255m Buy stamps\u001b[0m\u001b[K\u001b[7;1H\u001b[0;38;2;166;219;255m*** \u001b[0;38;2;255;192;185mTODO\u001b[0;38;2;166;219;255m Book the flights\u001b[0m\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H\u001b[0m** 1.2 Copy instead of moving \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[10;1H\u001b[0;38;2;179;246;192m=<leader>oR=\u001b[0m files a copy and keeps the original. On \u001b[0;38;2;179;246;192m=Renew the\u001b[0m\u001b[K\u001b[11;1H\u001b[0;38;2;179;246;192mpassport=\u001b[0m press \u001b[0;38;2;179;246;192m=<leader>oR=\u001b[0m and pick \u001b[0;38;2;179;246;192m=Errands=\u001b[0m: the task is\u001b[K\u001b[12;1H\u001b[0mnow in both places.\u001b[K\u001b[13;1H\u001b[K\u001b[14;1H\u001b[0;38;2;166;219;255m*** \u001b[0;38;2;255;192;185mTODO\u001b[0;38;2;166;219;255m Renew the passport\u001b[0m\u001b[K\u001b[15;1H\u001b[K\u001b[16;1H\u001b[0;1m* Errands\u001b[0m\u001b[K\u001b[17;1H\u001b[0mThe target of Lesson 1: refiled entries land at the end of it.\u001b[K\u001b[18;1H\u001b[K\u001b[19;1H\u001b[0;1m* Lesson 2: archive\u001b[0m\u001b[K\u001b[20;1H\u001b[0mArchiving puts done work out of the way, so the outline and the agenda\u001b[K\u001b[21;1H\u001b[0mstay short. Nothing is lost: archived entries keep their text.\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m organize.org                                                              25:1 \u001b[0m\u001b[K\u001b[1;1H"]
