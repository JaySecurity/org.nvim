[0,"o","\u001b[1;1H\u001b[0m#+TITLE:\u001b[0;1m org.nvim tutor 5: tables as a spreadsheet\u001b[0m \u001b[0;38;2;155;158;164m ✓ 0/14\u001b[0m\u001b[K\u001b[2;1H\u001b[0m#+STARTUP:\u001b[0;38;2;179;246;192m showall nologdone\u001b[0m\u001b[K\u001b[3;1H\u001b[0m#+TODO:\u001b[0;38;2;179;246;192m TODO | DONE\u001b[0m\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[0mAn org table is more than lined-up text: you move around it like a\u001b[K\u001b[6;1H\u001b[0mform, reshape it with a key, and give it formulas that compute\u001b[K\u001b[7;1H\u001b[0mcolumns and totals, like a small spreadsheet. The first lesson showed\u001b[K\u001b[8;1H\u001b[0mhow to align a table and add a row; this one goes further.\u001b[K\u001b[9;1H\u001b[K\u001b[10;1H\u001b[0;38;2;140;248;247m-\u001b[0m As before, a ✓ at the end of an exercise's headline means it is\u001b[K\u001b[11;1H\u001b[0m  done, and ✗ that it is not yet. Keys are shown as mapped in your\u001b[K\u001b[12;1H\u001b[0m  config; \u001b[0;38;2;179;246;192m=<leader>=\u001b[0m is \u001b[0;38;2;179;246;192m=<Space>=\u001b[0m.\u001b[K\u001b[13;1H\u001b[0;38;2;140;248;247m-\u001b[0m This is a working copy: \u001b[0;38;2;179;246;192m=:w=\u001b[0m saves your progress and \u001b[0;38;2;179;246;192m=:Org tutor\u001b[0m\u001b[K\u001b[14;1H\u001b[0;38;2;179;246;192m  tables reset=\u001b[0m starts over.\u001b[K\u001b[15;1H\u001b[0;38;2;140;248;247m-\u001b[0m Stuck? \u001b[0;38;2;179;246;192m=:Org tutor_hint=\u001b[0m shows the keys that solve the exercise at\u001b[K\u001b[16;1H\u001b[0m  the cursor, and \u001b[0;38;2;179;246;192m=:Org tutor=\u001b[0m lists every lesson.\u001b[K\u001b[17;1H\u001b[K\u001b[18;1H\u001b[0;1m* Lesson 1: moving around\u001b[0m\u001b[K\u001b[19;1H\u001b[0mIn Insert mode a table works like a form. Every move lines the table\u001b[K\u001b[20;1H\u001b[0mup again, and the first character you type after a move replaces the\u001b[K\u001b[21;1H\u001b[0mfield's text.\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m tables.org                                                                 1:1 \u001b[0m\u001b[K\u001b[23;1H\u001b[0m                                                                                \u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[2 q\u001b[1;1H"]
[1.5,"m","say: Tables you can move around, reshape and compute, like a spreadsheet."]
[7.96,"m","1.1 Next and previous field"]
[7.96,"o","\u001b[1;1H\u001b[0m** 1.1 Next and previous field \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0;38;2;179;246;192m=<Tab>=\u001b[0m goes to the next field,\u001b[K\u001b[3;1H\u001b[0;38;2;179;246;192m=<S-Tab>=\u001b[0m to the previous one. On \u001b[0;38;2;179;246;192m=Milk=\u001b[0m press\u001b[K\u001b[4;1H\u001b[0;38;2;179;246;192m=i=\u001b[0m, then \u001b[0;38;2;179;246;192m=<Tab>=\u001b[0m twice to reach its price, type\u001b[K\u001b[5;1H\u001b[0;38;2;179;246;192m=1.20=\u001b[0m and press \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m.\u001b[K\u001b[6;1H\u001b[K\u001b[7;1H\u001b[0m| Item  | Qty | Price |\u001b[K\u001b[8;1H\u001b[0m|-------+-----+-------|\u001b[K\u001b[9;1H\u001b[0m| Bread |   1 |  2.50 |\u001b[K\u001b[10;1H\u001b[0m| Milk  |   2 |       |\u001b[K\u001b[11;1H\u001b[K\u001b[12;1H\u001b[0m** 1.2 Down a column \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[13;1H\u001b[0;38;2;179;246;192m=<CR>=\u001b[0m goes to the same field of the next row. On \u001b[0;38;2;179;246;192m=Eggs=\u001b[0m press \u001b[0;38;2;179;246;192m=i=\u001b[0m and\u001b[K\u001b[14;1H\u001b[0;38;2;179;246;192m=<Tab>=\u001b[0m, type \u001b[0;38;2;179;246;192m=12=\u001b[0m, press \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m, type \u001b[0;38;2;179;246;192m=3=\u001b[0m and press\u001b[K\u001b[15;1H\u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m.\u001b[K\u001b[16;1H\u001b[K\u001b[17;1H\u001b[0m| Item  | Qty |\u001b[K\u001b[18;1H\u001b[0m|-------+-----|\u001b[K\u001b[19;1H\u001b[0m| Eggs  |     |\u001b[K\u001b[20;1H\u001b[0m| Flour |     |\u001b[K\u001b[21;1H\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m tables.org                                                                23:1 \u001b[0m\u001b[K\u001b[1;1H"]
