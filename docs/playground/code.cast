[7.33,"o","\u001b[1;1H\u001b[0m** 1.1 Run a block \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPut the cursor on the \u001b[0;38;2;179;246;192m=#+begin_src=\u001b[0m line below, press\u001b[K\u001b[3;1H\u001b[0;38;2;179;246;192m=<C-c><C-c>=\u001b[0m and answer \u001b[0;38;2;179;246;192m=y=\u001b[0m: the value the code returns\u001b[K\u001b[4;1H\u001b[0mappears under it.\u001b[K\u001b[5;1H\u001b[K\u001b[6;1H\u001b[0;38;2;166;219;255m*** The answer\u001b[0m\u001b[K\u001b[7;1H\u001b[0;38;2;155;158;164m#+begin_src lua\u001b[0m\u001b[K\u001b[8;1H\u001b[0m  \u001b[0;1mreturn\u001b[0m 6 * 7\u001b[K\u001b[9;1H\u001b[0;38;2;155;158;164m#+end_src\u001b[0m\u001b[K\u001b[10;1H\u001b[K\u001b[11;1H\u001b[0m** 1.2 Print instead of return \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[12;1H\u001b[0mThe result is the value the code returns (\u001b[0;38;2;179;246;192m=:results value=\u001b[0m, the\u001b[K\u001b[13;1H\u001b[0mdefault). With \u001b[0;38;2;179;246;192m=:results output=\u001b[0m it is what the code prints. Run this\u001b[K\u001b[14;1H\u001b[0mblock.\u001b[K\u001b[15;1H\u001b[K\u001b[16;1H\u001b[0;38;2;166;219;255m*** Greetings\u001b[0m\u001b[K\u001b[17;1H\u001b[0;38;2;155;158;164m#+begin_src lua :results output\u001b[0m\u001b[K\u001b[18;1H\u001b[0m  \u001b[0;38;2;140;248;247mprint\u001b[0m(\u001b[0;38;2;179;246;192m\"Hello from Lua\"\u001b[0m)\u001b[K\u001b[19;1H\u001b[0m  \u001b[0;38;2;140;248;247mprint\u001b[0m(\u001b[0;38;2;179;246;192m\"and hello again\"\u001b[0m)\u001b[K\u001b[20;1H\u001b[0;38;2;155;158;164m#+end_src\u001b[0m\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m code.org                                                                  27:1 \u001b[0m\u001b[K\u001b[1;1H"]
