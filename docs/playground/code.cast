[96.49,"o","\u001b[1;1H\u001b[0m** 4.1 Export to Markdown \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPut the cursor on \u001b[0;38;2;179;246;192m=Trip notes=\u001b[0m, press \u001b[0;38;2;179;246;192m=<leader>oe=\u001b[0m, \u001b[0;38;2;179;246;192m=s=\u001b[0m, \u001b[0;38;2;179;246;192m=m=\u001b[0m and \u001b[0;38;2;179;246;192m=M=\u001b[0m:\u001b[K\u001b[3;1H\u001b[0mits Markdown opens in a new window. \u001b[0;38;2;179;246;192m=:q=\u001b[0m closes it.\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[0;38;2;166;219;255m*** Trip notes\u001b[0m\u001b[K\u001b[6;1H\u001b[0mPack \u001b[0;1m*light*\u001b[0m and bring a \u001b[0;3m/good/\u001b[0m book.\u001b[K\u001b[7;1H\u001b[0;1m**** Monday\u001b[0m\u001b[K\u001b[8;1H\u001b[0mTrain to the coast.\u001b[K\u001b[9;1H\u001b[0;1m**** Tuesday\u001b[0m\u001b[K\u001b[10;1H\u001b[0mWalk to the lighthouse.\u001b[K\u001b[12;1H\u001b[0m** 4.2 Export options \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[13;1H\u001b[0mPlain text (\u001b[0;38;2;179;246;192m=t=\u001b[0m \u001b[0;38;2;179;246;192m=A=\u001b[0m) starts with the title and author, then a table of\u001b[K\u001b[14;1H\u001b[0mcontents, and numbers the sections. On the empty line below, write\u001b[K\u001b[15;1H\u001b[0;38;2;179;246;192m=#+OPTIONS: toc:nil num:nil author:nil=\u001b[0m to turn off the contents, the\u001b[K\u001b[16;1H\u001b[0mnumbers and the author: the line holds for the whole file, wherever it\u001b[K\u001b[17;1H\u001b[0mis. Then export \u001b[0;38;2;179;246;192m=Packing=\u001b[0m: \u001b[0;38;2;179;246;192m=<leader>oe=\u001b[0m, \u001b[0;38;2;179;246;192m=s=\u001b[0m, \u001b[0;38;2;179;246;192m=t=\u001b[0m, \u001b[0;38;2;179;246;192m=A=\u001b[0m.\u001b[K\u001b[18;1H\u001b[K\u001b[20;1H\u001b[0;38;2;166;219;255m*** Packing\u001b[0m\u001b[K\u001b[21;1H\u001b[0;1m**** Clothes\u001b[0m\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m code.org                                                                 178:1 \u001b[0m\u001b[K\u001b[1;1H"]
