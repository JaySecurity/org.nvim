[0,"o","\u001b[1;1H\u001b[0m#+TITLE:\u001b[0;1m org.nvim tutor 8: code and export\u001b[0m \u001b[0;38;2;155;158;164m ✓ 0/12\u001b[0m\u001b[K\u001b[2;1H\u001b[0m#+STARTUP:\u001b[0;38;2;179;246;192m showall nologdone\u001b[0m\u001b[K\u001b[3;1H\u001b[0m#+TODO:\u001b[0;38;2;179;246;192m TODO | DONE\u001b[0m\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[0mAn org file can hold code that runs, with its results written right\u001b[K\u001b[6;1H\u001b[0munder it, and any part of the file exports to Markdown, plain text,\u001b[K\u001b[7;1H\u001b[0mHTML and more. The code here is Lua: it needs nothing installed, as Lua\u001b[K\u001b[8;1H\u001b[0mblocks run inside Neovim.\u001b[K\u001b[9;1H\u001b[K\u001b[10;1H\u001b[0;38;2;140;248;247m-\u001b[0m As before, a ✓ at the end of an exercise's headline means it is\u001b[K\u001b[11;1H\u001b[0m  done, and ✗ that it is not yet. Keys are shown as mapped in your\u001b[K\u001b[12;1H\u001b[0m  config; \u001b[0;38;2;179;246;192m=<leader>=\u001b[0m is \u001b[0;38;2;179;246;192m=<Space>=\u001b[0m.\u001b[K\u001b[13;1H\u001b[0;38;2;140;248;247m-\u001b[0m This is a working copy: \u001b[0;38;2;179;246;192m=:w=\u001b[0m saves your progress and \u001b[0;38;2;179;246;192m=:Org tutor code\u001b[0m\u001b[K\u001b[14;1H\u001b[0;38;2;179;246;192m  reset=\u001b[0m starts over. Exports here go to a buffer, not to a file; only\u001b[K\u001b[15;1H\u001b[0m  3.1 writes a file, \u001b[0;38;2;179;246;192m=hello.lua=\u001b[0m, next to this copy.\u001b[K\u001b[16;1H\u001b[0;38;2;140;248;247m-\u001b[0m Before a block runs you are asked \"Evaluate this lua code block on\u001b[K\u001b[17;1H\u001b[0m  your system?\": \u001b[0;38;2;179;246;192m=y=\u001b[0m runs it, \u001b[0;38;2;179;246;192m=n=\u001b[0m (or \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m) doesn't. Run only code\u001b[K\u001b[18;1H\u001b[0m  you trust; the option \u001b[0;38;2;179;246;192m=babel.confirm_evaluate = false=\u001b[0m stops asking.\u001b[K\u001b[19;1H\u001b[0;38;2;140;248;247m-\u001b[0m Stuck? \u001b[0;38;2;179;246;192m=:Org tutor_hint=\u001b[0m shows the keys that solve the exercise at\u001b[K\u001b[20;1H\u001b[0m  the cursor, and \u001b[0;38;2;179;246;192m=:Org tutor=\u001b[0m lists every lesson.\u001b[K\u001b[21;1H\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m code.org                                                                   1:1 \u001b[0m\u001b[K\u001b[23;1H\u001b[0m                                                                                \u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[2 q\u001b[1;1H"]
