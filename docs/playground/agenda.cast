[7.87,"o","\u001b[1;1H\u001b[0m** 1.1 The TODO list \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPress \u001b[0;38;2;179;246;192m=<leader>oa=\u001b[0m, \u001b[0;38;2;179;246;192m=<=\u001b[0m and \u001b[0;38;2;179;246;192m=t=\u001b[0m: every TODO item of this file. On\u001b[K\u001b[3;1H\u001b[0;38;2;179;246;192m=Renew the passport=\u001b[0m press \u001b[0;38;2;179;246;192m=+=\u001b[0m: it gets priority B, in the file\u001b[K\u001b[4;1H\u001b[0mtoo. Press it again for A; \u001b[0;38;2;179;246;192m=-=\u001b[0m lowers it.\u001b[K\u001b[5;1H\u001b[K\u001b[6;1H\u001b[0;38;2;166;219;255m*** \u001b[0;38;2;255;192;185mTODO\u001b[0;38;2;166;219;255m Renew the passport\u001b[0m\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[0m** 1.2 The week \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[9;1H\u001b[0mPress \u001b[0;38;2;179;246;192m=<leader>oa=\u001b[0m, \u001b[0;38;2;179;246;192m=<=\u001b[0m, \u001b[0;38;2;179;246;192m=a=\u001b[0m. \u001b[0;38;2;179;246;192m=Pay the rent=\u001b[0m is overdue, so it\u001b[K\u001b[10;1H\u001b[0mshows on today. \u001b[0;38;2;179;246;192m=f=\u001b[0m and \u001b[0;38;2;179;246;192m=b=\u001b[0m go a week forward and back, \u001b[0;38;2;179;246;192m=.=\u001b[0m comes\u001b[K\u001b[11;1H\u001b[0mback to today, and \u001b[0;38;2;179;246;192m=vd=\u001b[0m / \u001b[0;38;2;179;246;192m=vw=\u001b[0m show one day or the week. On\u001b[K\u001b[12;1H\u001b[0;38;2;179;246;192m=Pay the rent=\u001b[0m press \u001b[0;38;2;179;246;192m=t=\u001b[0m: it is DONE.\u001b[K\u001b[13;1H\u001b[K\u001b[14;1H\u001b[0;38;2;166;219;255m*** \u001b[0;38;2;255;192;185mTODO\u001b[0;38;2;166;219;255m Pay the rent\u001b[0m\u001b[K\u001b[15;1H\u001b[0;1mDEADLINE:\u001b[0m \u001b[0;4m<2026-10-05 Mon>\u001b[0m\u001b[K\u001b[16;1H\u001b[K\u001b[17;1H\u001b[0;1m* Lesson 2: dates from the agenda\u001b[0m\u001b[K\u001b[18;1H\u001b[0mThe agenda changes the entries themselves: every key below edits the\u001b[K\u001b[19;1H\u001b[0mheadline in its file, wherever that fi