[8.14,"m","1.1 Follow a link"]
[8.14,"o","\u001b[1;1H\u001b[0m** 1.1 Follow a link \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPut the cursor on the link below and press \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m: the cursor jumps to\u001b[K\u001b[3;1H\u001b[0mthe headline it names.\u001b[K\u001b[5;1H\u001b[0;38;2;140;248;247m-\u001b[0m Before you go out, read the \u001b[0;4mshopping list\u001b[0m.\u001b[K\u001b[6;1H\u001b[K\u001b[7;1H\u001b[0;38;2;166;219;255m*** Shopping list\u001b[0m\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H\u001b[0m** 1.2 Insert a link \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[10;1H\u001b[0mAfter a space at the end of \u001b[0;38;2;179;246;192m=Manual:=\u001b[0m, press \u001b[0;38;2;179;246;192m=<leader>oli=\u001b[0m, type\u001b[K\u001b[11;1H\u001b[0;38;2;179;246;192m=https://orgmode.org=\u001b[0m and \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m, then \u001b[0;38;2;179;246;192m=Org manual=\u001b[0m and \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m for its\u001b[K\u001b[12;1H\u001b[0mdescription.\u001b[K\u001b[13;1H\u001b[K\u001b[14;1H\u001b[0;38;2;140;248;247m-\u001b[0m Manual:\u001b[K\u001b[15;1H\u001b[K\u001b[16;1H\u001b[0m** 1.3 Link to a target \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[17;1H\u001b[0;38;2;179;246;192m=<<door code>>=\u001b[0m below is a target: links to it are written\u001b[K\u001b[18;1H\u001b[0;38;2;179;246;192m=[[door code]]=\u001b[0m. After a space at the end of \u001b[0;38;2;179;246;192m=Visitors:=\u001b[0m, press\u001b[K\u001b[19;1H\u001b[0;38;2;179;246;192m=<leader>oli=\u001b[0m, type \u001b[0;38;2;179;246;192m=door code=\u001b[0m and \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m, then \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m again\u001b[K\u001b[20;1H\u001b[0mfor no description.\u001b[K\u001b[21;1H\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m links.org                                                                 26:1 \u001b[0m\u001b[K\u001b[1;1H"]
