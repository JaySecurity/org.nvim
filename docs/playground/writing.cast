13mv\u001b[0;48;2;7;8;13m    verse                        │\u001b[0m\u001b[K\u001b[17;1H\u001b[0m                      \u001b[0;48;2;7;8;13m│  \u001b[0;38;2;140;248;247;48;2;7;8;13mTAB\u001b[0;48;2;7;8;13m  (TAB) any block type         │\u001b[0m\u001b[K\u001b[18;1H\u001b[0m** 3.4 Edit code in it\u001b[0;48;2;7;8;13m╰─────────────\u001b[0;1;48;2;7;8;13m Esc quit \u001b[0;48;2;7;8;13m─────────────╯\u001b[0m\u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[8;1H"]
