[110.035,"o","\u001b[1;1H\u001b[0m** 4.2 Jump to a definition and back \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPut the cursor on \u001b[0;38;2;179;246;192m=[fn:milk]=\u001b[0m after \u001b[0;38;2;179;246;192m=Coffee with milk.=\u001b[0m and press\u001b[K\u001b[3;1H\u001b[0;38;2;179;246;192m=<leader>oif=\u001b[0m: the cursor jumps to the definition. It has no\u001b[K\u001b[4;1H\u001b[0mtext yet: press \u001b[0;38;2;179;246;192m=A=\u001b[0m, type a space and \u001b[0;38;2;179;246;192m=Just a drop.=\u001b[0m, then \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m. On\u001b[K\u001b[5;1H\u001b[0mthe definition's label (\u001b[0;38;2;179;246;192m=0=\u001b[0m), the same key jumps back to the reference.\u001b[K\u001b[6;1H\u001b[0;38;2;179;246;192m=<CR>=\u001b[0m follows a footnote too.\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[0mCoffee with milk.\u001b[0;4m[fn:milk]\u001b[0m\u001b[K\u001b[9;1H\u001b[K\u001b[10;1H\u001b[0;4m[fn:milk]\u001b[0m\u001b[K\u001b[11;1H\u001b[K\u001b[12;1H\u001b[0;1m* What next\u001b[0m\u001b[K\u001b[13;1H\u001b[0mYou can write in org now. From here:\u001b[K\u001b[14;1H\u001b[K\u001b[15;1H\u001b[0;38;2;140;248;247m-\u001b[0m \u001b[0;38;2;179;246;192m=g?=\u001b[0m lists every key; \u001b[0;38;2;179;246;192m=:h org-footnotes=\u001b[0m, \u001b[0;38;2;179;246;192m=:h org-fill=\u001b[0m and\u001b[K\u001b[16;1H\u001b[0m  \u001b[0;38;2;179;246;192m=:h org-babel-edit-special=\u001b[0m tell more about this lesson's keys.\u001b[K\u001b[17;1H\u001b[0;38;2;140;248;247m-\u001b[0m \u001b[0;38;2;179;246;192m=<leader>oe=\u001b[0m exports this file to HTML, Markdown, LaTeX and more:\u001b[K\u001b[18;1H\u001b[0m  that is where the markup, keywords and footnotes show their worth.\u001b[K\u001b[19;1H\u001b[0;38;2;140;248;247m-\u001b[0m \u001b[0;4mexamples/00-index.org\u001b[0m links to one file per feature, each with many examples\u001b[K\u001b[20;1H\u001b[0m  and exercises.\u001b[K\u001b[21;1H\u001b[0;38;2;79;82;88m                                