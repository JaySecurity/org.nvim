[94.59,"o","\u001b[1;1H\u001b[0m** 3.4 Edit code in its own window \u001b[0;38;2;179;246;192m ✓\u001b[0m\u001b[K\u001b[4;1H\u001b[0mfor its language (indenting, highlighting, completion). Change \u001b[0;38;2;179;246;192m=hello=\u001b[0m\u001b[K\u001b[5;1H\u001b[0mto \u001b[0;38;2;179;246;192m=world=\u001b[0m (\u001b[0;38;2;179;246;192m=ciw=\u001b[0m), then press \u001b[0;38;2;179;246;192m=<C-c>'=\u001b[0m to put it back\u001b[K\u001b[6;1H\u001b[0min the block.\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[0;38;2;155;158;164m#+begin_src python\u001b[0m\u001b[K\u001b[9;1H\u001b[0m  \u001b[0;38;2;140;248;247mprint\u001b[0m(\u001b[0;38;2;179;246;192m\"world\"\u001b[0m)\u001b[K\u001b[10;1H\u001b[0;38;2;155;158;164m#+end_src\u001b[0m\u001b[K\u001b[11;1H\u001b[K\u001b[12;1H\u001b[0;1m* Lesson 4: footnotes\u001b[0m\u001b[K\u001b[13;1H\u001b[0mA footnote is a reference in the text, a label such as \u001b[0;38;2;179;246;192m=fn:1=\u001b[0m in square\u001b[K\u001b[14;1H\u001b[0mbrackets, and a definition: a paragraph that starts with the same\u001b[K\u001b[15;1H\u001b[0mreference. This file has \u001b[0;38;2;179;246;192m=#+STARTUP: fnlocal=\u001b[0m, so a new definition goes\u001b[K\u001b[16;1H\u001b[0mat the end of the section; by default it goes under a \u001b[0;38;2;179;246;192m=Footnotes=\u001b[0m\u001b[K\u001b[17;1H\u001b[0mheadline at the end of the file.\u001b[K\u001b[18;1H\u001b[K\u001b[19;1H\u001b[0m** 4.1 Add a footnote \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[20;1H\u001b[0mPut the cursor at the end of the \u001b[0;38;2;179;246;192m=Tea=\u001b[0m line and press\u001b[K\u001b[21;1H\u001b[0;38;2;179;246;192m=<leader>oif=\u001b[0m. A reference goes in the text and the cursor\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m writing.org                                                             108:14 \u001b[0m\u001b[K\u001b[9;14H"]
[99.485,"m","4.1 Add a footnote"]
[99.485,"o","\u001b[1;1H\u001b[0m** 4.1 Add a footnote \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mPut the cursor at the end of the \u001b[0;38;2;179;246;192m=Tea=\u001b[0m line and press\u001b[K\u001b[3;1H\u001b[0;38;2;179;246;192m=<leader>oif=\u001b[0m. A reference goes in the text and the cursor\u001b[K\u001b[4;1H\u001b[0mjumps to its new definition, in Insert mode: type \u001b[0;38;2;179;246;192m=Green or black.=\u001b[0m and\u001b[K\u001b[5;1H\u001b[0mpress \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m.\u001b[K\u001b[6;1H\u001b[K\u001b[7;1H\u001b[0mTea is ready.\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H\u001b[0m** 4.2 Jump to a definition and back \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[10;1H\u001b[0mPut the cursor on \u001b[0;38;2;179;246;192m=[fn:milk]=\u001b[0m after \u001b[0;38;2;179;246;192m=Coffee with milk.=\u001b[0m and press\u001b[K\u001b[11;1H\u001b[0;38;2;179;246;192m=<leader>oif=\u001b[0m: the cursor jumps to the definition. It has no\u001b[K\u001b[12;1H\u001b[0mtext yet: press \u001b[0;38;2;179;246;192m=A=\u001b[0m, type a space and \u001b[0;38;2;179;246;192m=Just a drop.=\u001b[0m, then \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m. On\u001b[K\u001b[13;1H\u001b[0mthe definition's label (\u001b[0;38;2;179;246;192m=0=\u001b[0m), the same key jumps back to the reference.\u001b[K\u001b[14;1H\u001b[0;38;2;179;246;192m=<CR>=\u001b[0m follows a footnote too.\u001b[K\u001b[15;1H\u001b[K\u001b[16;1H\u001b[0mCoffee with milk.\u001b[0;4m[fn:milk]\u001b[0m\u001b[K\u001b[17;1H\u001b[K\u001b[18;1H\u001b[0;4m[fn:milk]\u001b[0m\u001b[K\u001b[19;1H\u001b[K\u001b[20;1H\u001b[0;1m* What next\u001b[0m\u001b[K\u001b[21;1H\u001b[0mYou can write in org now. From here:\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m writing.org                                                              118:1 \u001b[0m\u001b[K\u001b[1;1H"]
