[0,"o","\u001b[1;1H\u001b[0m#+TITLE:\u001b[0;1m org.nvim tutor 5: writing in org\u001b[0m \u001b[0;38;2;155;158;164m ✓ 0/11\u001b[0m\u001b[K\u001b[2;1H\u001b[0m#+STARTUP:\u001b[0;38;2;179;246;192m showall nologdone fnlocal\u001b[0m\u001b[K\u001b[3;1H\u001b[0m#+TODO:\u001b[0;38;2;179;246;192m TODO | DONE\u001b[0m\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[0mAn org file is mostly text. This lesson shows how to write it: bold and\u001b[K\u001b[6;1H\u001b[0mitalic words, paragraphs, keywords, blocks of quotes and code, and\u001b[K\u001b[7;1H\u001b[0mfootnotes. It assumes the keys of the first lesson (\u001b[0;38;2;179;246;192m=:Org tutor basics=\u001b[0m).\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H\u001b[0;38;2;140;248;247m-\u001b[0m As before, a ✓ at the end of an exercise's headline means it is\u001b[K\u001b[10;1H\u001b[0m  done, and ✗ that it is not yet. Keys are shown as mapped in your\u001b[K\u001b[11;1H\u001b[0m  config; \u001b[0;38;2;179;246;192m=<leader>=\u001b[0m is \u001b[0;38;2;179;246;192m=<Space>=\u001b[0m.\u001b[K\u001b[12;1H\u001b[0;38;2;140;248;247m-\u001b[0m This is a working copy: \u001b[0;38;2;179;246;192m=:w=\u001b[0m saves your progress and \u001b[0;38;2;179;246;192m=:Org tutor\u001b[0m\u001b[K\u001b[13;1H\u001b[0;38;2;179;246;192m  writing reset=\u001b[0m starts over.\u001b[K\u001b[14;1H\u001b[0;38;2;140;248;247m-\u001b[0m Stuck? \u001b[0;38;2;179;246;192m=:Org tutor_hint=\u001b[0m shows the keys that solve the exercise at\u001b[K\u001b[15;1H\u001b[0m  the cursor, and \u001b[0;38;2;179;246;192m=:Org tutor=\u001b[0m lists every lesson.\u001b[K\u001b[16;1H\u001b[K\u001b[17;1H\u001b[0;1m* Lesson 1: emphasis\u001b[0m\u001b[K\u001b[18;1H\u001b[0mPut a marker on each side of a word to style it: \u001b[0;1m*bold*\u001b[0m, \u001b[0;3m/italic/\u001b[0m,\u001b[K\u001b[19;1H\u001b[0;4m_underline_\u001b[0m, \u001b[0;9m+strike-through+\u001b[0m, \u001b[0;38;2;179;246;192m=verbatim=\u001b[0m and \u001b[0;38;2;179;246;192m~code~\u001b[0m. The markers stay\u001b[K\u001b[20;1H\u001b[0min the text, which is plain to read anywhere. Set\u001b[K\u001b[21;1H\u001b[0;38;2;179;246;192m=ui.hide_emphasis_markers=\u001b[0m in your config to hide them on screen.\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m writing.org                                                                1:1 \u001b[0m\u001b[K\u001b[23;1H\u001b[0m                                                                                \u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[2 q\u001b[1;1H"]
[1.5,"m","say: Markup, paragraphs, blocks and footnotes, tried out in this file."]
[7.825,"m","1.1 Make a word bold"]
[7.825,"o","\u001b[1;1H\u001b[0m** 1.1 Make a word bold \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mSelect the word \u001b[0;38;2;179;246;192m=important=\u001b[0m with \u001b[0;38;2;179;246;192m=viw=\u001b[0m and press \u001b[0;38;2;179;246;192m=<leader>oE=\u001b[0m,\u001b[K\u001b[3;1H\u001b[0mthen \u001b[0;38;2;179;246;192m=*=\u001b[0m: the markers go around the selection. Any marker of the six\u001b[K\u001b[4;1H\u001b[0mworks the same way.\u001b[K\u001b[5;1H\u001b[K\u001b[6;1H\u001b[0mThis step is important for the rest.\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[0m** 1.2 Type in italics \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[9;1H\u001b[0mWith nothing selected, \u001b[0;38;2;179;246;192m=<leader>oE=\u001b[0m puts a pair of markers at the\u001b[K\u001b[10;1H\u001b[0mcursor and leaves you typing between them. On the empty line below\u001b[K\u001b[11;1H\u001b[0;38;2;179;246;192m=Notes:=\u001b[0m, press \u001b[0;38;2;179;246;192m=<leader>oE=\u001b[0m and \u001b[0;38;2;179;246;192m=/=\u001b[0m, type \u001b[0;38;2;179;246;192m=in italics=\u001b[0m and press\u001b[K\u001b[12;1H\u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m.\u001b[K\u001b[13;1H\u001b[K\u001b[14;1H\u001b[0mNotes:\u001b[K\u001b[15;1H\u001b[K\u001b[17;1H\u001b[0;1m* Lesson 2: paragraphs\u001b[0m\u001b[K\u001b[18;1H\u001b[0mA blank line separates paragraphs. Inside one, line breaks don't matter\u001b[K\u001b[19;1H\u001b[0mwhen you export: the lines are joined.\u001b[K\u001b[20;1H\u001b[K\u001b[21;1H\u001b[0m** 2.1 Fill a paragraph \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m writing.org                                                               23:1 \u001b[0m\u001b[K\u001b[1;1H"]
