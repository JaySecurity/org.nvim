[62.925,"o","\u001b[1;1H\u001b[0m** 3.2 Quote a paragraph \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[2;1H\u001b[0mSelect the two lines of the poem with \u001b[0;38;2;179;246;192m=Vj=\u001b[0m and press\u001b[K\u001b[3;1H\u001b[0;38;2;179;246;192m=<leader>oib=\u001b[0m: a menu of block types opens. Press\u001b[K\u001b[4;1H\u001b[0;38;2;179;246;192m=q=\u001b[0m and the lines are wrapped in a quote block. \u001b[0;38;2;179;246;192m=e=\u001b[0m makes an example\u001b[K\u001b[5;1H\u001b[0mblock, \u001b[0;38;2;179;246;192m=s=\u001b[0m a source block, \u001b[0;38;2;179;246;192m=v=\u001b[0m a verse.\u001b[K\u001b[6;1H\u001b[K\u001b[7;1H\u001b[0mHope is the thing with feathers\u001b[K\u001b[8;1H\u001b[0mThat perches in the soul\u001b[K\u001b[10;1H\u001b[0m** 3.3 Insert a source block \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[11;1H\u001b[0mOn the empty line below \u001b[0;38;2;179;246;192m=Code:=\u001b[0m, press \u001b[0;38;2;179;246;192m=<leader>oib=\u001b[0m\u001b[K\u001b[12;1H\u001b[0mand \u001b[0;38;2;179;246;192m=s=\u001b[0m. The cursor waits after \u001b[0;38;2;179;246;192m=#+begin_src=\u001b[0m for the language: type\u001b[K\u001b[13;1H\u001b[0;38;2;179;246;192m=python=\u001b[0m, press \u001b[0;38;2;179;246;192m=<CR>=\u001b[0m and type \u001b[0;38;2;179;246;192m=print(\"hello\")=\u001b[0m, then \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m.\u001b[K\u001b[14;1H\u001b[K\u001b[15;1H\u001b[0mCode:\u001b[K\u001b[16;1H\u001b[K\u001b[18;1H\u001b[0m** 3.4 Edit code in its own window \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[19;1H\u001b[0mPut the cursor on \u001b[0;38;2;179;246;192m=hello=\u001b[0m in the block below and press\u001b[K\u001b[20;1H\u001b[0;38;2;179;246;192m=<leader>o'=\u001b[0m: the code opens in a window of its own, set up\u001b[K\u001b[21;1H\u001b[0mfor its language (indenting, highlighting, completion). Change \u001b[0;38;2;179;246;192m=hello=\u001b[0m\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m writing.org                                                               79:1 \u001b[0m\u001b[K\u001b[1;1H"]
